<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>
:root{color-scheme:dark;--bg:#070a0f;--panel:#0e141d;--panel2:#131c28;--line:#263449;--text:#eef4ff;--muted:#8fa0b8;--purple:#c66bff;--cyan:#44e5ff;--critical:#ff3f6c;--high:#ff8c42;--medium:#ffd166;--low:#44e5ff;--ok:#55e6a5}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 82% 0,rgba(198,107,255,.11),transparent 30%),linear-gradient(180deg,#090d14,var(--bg));color:var(--text);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}main{max-width:1400px;margin:auto;padding:38px 24px 90px}.eyebrow{color:var(--purple);font-size:.72rem;font-weight:900;letter-spacing:.2em;text-transform:uppercase}h1{font-size:clamp(2.6rem,7vw,5.6rem);line-height:.94;margin:.35rem 0 1rem;letter-spacing:-.05em}h2{margin:.25rem 0 1rem}h3{margin:.3rem 0}.muted{color:var(--muted)}.panel{background:linear-gradient(145deg,rgba(17,24,35,.96),rgba(11,16,24,.96));border:1px solid var(--line);border-radius:18px;box-shadow:0 20px 70px rgba(0,0,0,.22)}.hero{display:grid;grid-template-columns:1.5fr .5fr;gap:20px;align-items:stretch}.hero-copy{padding:32px}.summary{font-size:1.04rem;color:#c8d4e6;max-width:900px}.score-panel{padding:24px;display:grid;place-items:center}.gauge{--score:0;--gauge-color:var(--cyan);width:170px;height:170px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--gauge-color) calc(var(--score)*1%),#202a39 0);position:relative}.gauge:before{content:"";position:absolute;inset:13px;border-radius:50%;background:#0c121b}.gauge-content{position:relative;text-align:center}.gauge strong{display:block;font-size:2.25rem}.badge{display:inline-flex;align-items:center;border:1px solid currentColor;border-radius:999px;padding:3px 9px;font-size:.7rem;font-weight:900;text-transform:uppercase}.critical{color:var(--critical)}.high{color:var(--high)}.medium{color:var(--medium)}.low{color:var(--low)}.informational{color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.stat{padding:18px}.stat strong{display:block;color:var(--cyan);font-size:1.8rem}.section{margin-top:26px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.matrix{display:grid;grid-template-columns:repeat(7,1fr);gap:9px;padding:15px}.tactic{min-height:85px;padding:12px;border:1px solid var(--line);border-radius:11px;background:#0b1119;color:var(--muted)}.tactic.active{border-color:rgba(198,107,255,.65);background:linear-gradient(145deg,rgba(198,107,255,.16),rgba(68,229,255,.05));color:var(--text);box-shadow:inset 0 0 22px rgba(198,107,255,.06)}.tactic b{display:block;font-size:.78rem}.tactic span{font-size:1.4rem;font-weight:900;color:var(--purple)}.platforms{display:flex;gap:9px;flex-wrap:wrap}.platform{padding:7px 11px;border:1px solid var(--line);border-radius:9px;background:#0b1119}.timeline{padding:18px}.timeline-item{display:grid;grid-template-columns:100px 24px 1fr;gap:12px;min-height:95px}.timeline-time{color:var(--cyan);font-family:ui-monospace,monospace;font-weight:700}.timeline-track{position:relative;display:flex;justify-content:center}.timeline-track:before{content:"";width:1px;background:var(--line);position:absolute;top:9px;bottom:-10px}.timeline-item:last-child .timeline-track:before{bottom:55%}.dot{z-index:1;width:13px;height:13px;border-radius:50%;background:var(--purple);box-shadow:0 0 18px var(--purple);margin-top:5px}.timeline-card{padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:#0b1119;margin-bottom:12px}.timeline-card .meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:7px}.workspace{display:grid;grid-template-columns:1fr 1fr;gap:18px}.ioc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:16px}.ioc-card{padding:12px;border-radius:11px;border:1px solid var(--line);background:#0b1119;min-width:0}.ioc-card h4{margin:0 0 8px;color:var(--cyan);text-transform:uppercase;font-size:.72rem;letter-spacing:.1em}.ioc-value{font:12px/1.5 ui-monospace,monospace;overflow-wrap:anywhere;color:#d7e4f5}.graph-wrap{padding:14px;overflow:hidden}.graph{width:100%;height:430px;background:radial-gradient(circle at center,rgba(68,229,255,.04),transparent 55%),#090e15;border:1px solid var(--line);border-radius:12px}.edge{stroke:#34445c;stroke-width:1}.node circle{fill:#111b28;stroke:var(--cyan);stroke-width:1.5}.node.incident circle{stroke:var(--purple);fill:#1d1325}.node.technique circle{stroke:var(--purple)}.node.event circle{stroke:var(--high)}.node text{fill:#eaf1fb;font-size:10px}.events{display:grid;gap:18px}.event{padding:22px}.event-head{display:flex;justify-content:space-between;gap:18px}.event-score{text-align:right}.event-score strong{font-size:1.9rem}.mapping{padding:17px;margin-top:14px;border:1px solid var(--line);border-radius:13px;background:var(--panel2)}.mapping-head{display:flex;justify-content:space-between;gap:14px}.technique-id{color:var(--cyan);font:700 13px ui-monospace,monospace}.quality{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;margin:12px 0}.bar{height:8px;background:#263143;border-radius:999px;overflow:hidden}.bar span{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--purple));border-radius:inherit}details{margin-top:12px}summary{cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#080c12;border:1px solid var(--line);padding:13px;border-radius:10px;font:12px/1.5 ui-monospace,monospace}footer{margin-top:32px;color:var(--muted);font-size:.82rem}@media(max-width:1000px){.hero,.workspace{grid-template-columns:1fr}.matrix{grid-template-columns:repeat(4,1fr)}}@media(max-width:700px){main{padding:22px 13px 65px}.stats{grid-template-columns:repeat(2,1fr)}.matrix{grid-template-columns:repeat(2,1fr)}.ioc-grid{grid-template-columns:1fr}.timeline-item{grid-template-columns:75px 18px 1fr}.event-head{flex-direction:column}.event-score{text-align:left}}
</style>
</head>
<body><main>
<section class="hero">
<div class="panel hero-copy"><div class="eyebrow">BLACKTERM SECURITY RESEARCH</div><h1>MITRE<br>MAPPER</h1><p class="summary">{{ summary }}</p><div class="platforms">{% for platform in platforms %}<span class="platform">{% if platform == 'Windows' %}▣{% elif platform == 'Linux' %}◈{% elif platform == 'macOS' %}◆{% else %}◇{% endif %} {{ platform }}</span>{% endfor %}</div></div>
<div class="panel score-panel"><div class="gauge" style="--score:{{ max_risk }};--gauge-color:var(--{{ overall_severity }})"><div class="gauge-content"><strong>{{ max_risk }}</strong><span>/100</span><br><span class="badge {{ overall_severity }}">{{ overall_severity }}</span></div></div></div>
</section>
<section class="stats"><div class="panel stat"><strong>{{ event_count }}</strong><span>Events analyzed</span></div><div class="panel stat"><strong>{{ mapping_count }}</strong><span>ATT&amp;CK mappings</span></div><div class="panel stat"><strong>{{ ioc_count }}</strong><span>Extracted indicators</span></div><div class="panel stat"><strong>{{ technique_counts|length }}</strong><span>Unique techniques</span></div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Coverage</div><h2>ATT&amp;CK tactic matrix</h2></div></div><div class="panel matrix">{% for tactic in tactics %}<div class="tactic {% if tactic.active %}active{% endif %}"><b>{{ tactic.label }}</b><span>{{ tactic.count if tactic.active else '—' }}</span></div>{% endfor %}</div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Sequence</div><h2>Investigation timeline</h2></div></div><div class="panel timeline">{% for item in results_view %}<div class="timeline-item"><div class="timeline-time">{{ item.time_short }}</div><div class="timeline-track"><div class="dot"></div></div><div class="timeline-card"><div class="eyebrow">Event {{ item.sequence }}</div><h3>{{ item.primary_action }}</h3><div class="muted">{{ item.timestamp_label }} · {{ item.result.event_id }}</div><div class="meta"><span class="badge {{ item.result.highest_severity }}">{{ item.result.highest_severity }}</span><span class="badge low">Risk {{ item.result.risk_score }}/100</span>{% for mapping in item.result.mappings[:3] %}<span class="badge informational">{{ mapping.technique_id }}</span>{% endfor %}</div></div></div>{% endfor %}</div></section>
<section class="section workspace"><div><div class="section-head"><div><div class="eyebrow">Indicators</div><h2>IOC extraction</h2></div></div><div class="panel ioc-grid">{% if all_iocs %}{% for kind, values in all_iocs.items() %}<div class="ioc-card"><h4>{{ kind|replace('_',' ') }}</h4>{% for value in values %}<div class="ioc-value">{{ value }}</div>{% endfor %}</div>{% endfor %}{% else %}<div class="muted">No indicators extracted.</div>{% endif %}</div></div>
<div><div class="section-head"><div><div class="eyebrow">Connections</div><h2>Relationship graph</h2></div></div><div class="panel graph-wrap"><svg class="graph" id="relationshipGraph" viewBox="0 0 700 430" data-nodes='{{ relationship_graph.nodes|tojson }}' data-edges='{{ relationship_graph.edges|tojson }}'></svg></div></div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Evidence</div><h2>Event analysis</h2></div></div><div class="events">{% for item in results_view %}<article class="panel event"><div class="event-head"><div><div class="eyebrow">Event {{ item.sequence }}</div><h2>{{ item.result.event_id }}</h2><div class="muted">{{ item.result.source or 'Unknown source' }} · {{ item.timestamp_label }}</div></div><div class="event-score"><strong>{{ item.result.risk_score }}/100</strong><br><span class="badge {{ item.result.highest_severity }}">{{ item.result.highest_severity }}</span></div></div><div class="quality"><div><b>Evidence quality</b><div class="bar"><span style="width:{{ item.evidence_quality }}%"></span></div></div><strong>{{ item.evidence_quality }}%</strong></div><div class="muted">{{ item.matched_evidence }} matched evidence points{% if item.entities %} · {{ item.entities|length }} linked entities{% endif %}</div><details><summary>Raw event</summary><pre>{{ item.result.event|tojson(indent=2) }}</pre></details>{% for mapping in item.result.mappings %}<section class="mapping"><div class="mapping-head"><div><div class="technique-id">{{ mapping.technique_id }}</div><h3>{{ mapping.technique_name }}</h3></div><span class="badge {{ mapping.severity }}">{{ mapping.severity }}</span></div><p>{{ mapping.description }}</p><p><b>Tactics:</b> {{ mapping.tactics|join(', ') }}<br><b>Confidence:</b> {{ (mapping.confidence*100)|round|int }}%<br><b>Platforms:</b> {{ mapping.platforms|join(', ') or 'Unspecified' }}<br><b>Rule:</b> {{ mapping.rule_id }}</p><details><summary>Matched evidence</summary><ul>{% for evidence in mapping.evidence if evidence.matched %}<li><code>{{ evidence.field }}</code> {{ evidence.operator }} <code>{{ evidence.expected }}</code>{% if evidence.observed is not none %}<div class="muted">Observed: {{ evidence.observed }}</div>{% endif %}</li>{% endfor %}</ul></details></section>{% endfor %}</article>{% endfor %}</div></section>
<footer>ATT&amp;CK mappings are investigative context, not proof of malicious activity. Review surrounding telemetry and asset context. This project is not affiliated with or endorsed by MITRE.</footer>
</main>
<script>
(()=>{const svg=document.getElementById('relationshipGraph');const nodes=JSON.parse(svg.dataset.nodes||'[]'),edges=JSON.parse(svg.dataset.edges||'[]');if(!nodes.length)return;const NS='http://www.w3.org/2000/svg',cx=350,cy=215,positions={};nodes.forEach((n,i)=>{if(n.id==='incident'){positions[n.id]={x:cx,y:cy};return}const angle=(i-1)/Math.max(1,nodes.length-1)*Math.PI*2-Math.PI/2;const ring=n.kind==='event'?105:n.kind==='technique'?180:155+(i%2)*50;positions[n.id]={x:cx+Math.cos(angle)*ring,y:cy+Math.sin(angle)*ring*.78}});edges.forEach(e=>{const a=positions[e.source],b=positions[e.target];if(!a||!b)return;const line=document.createElementNS(NS,'line');line.setAttribute('x1',a.x);line.setAttribute('y1',a.y);line.setAttribute('x2',b.x);line.setAttribute('y2',b.y);line.setAttribute('class','edge');svg.appendChild(line)});nodes.forEach(n=>{const p=positions[n.id],g=document.createElementNS(NS,'g');g.setAttribute('class',`node ${n.kind}`);const c=document.createElementNS(NS,'circle');c.setAttribute('cx',p.x);c.setAttribute('cy',p.y);c.setAttribute('r',n.id==='incident'?30:n.kind==='event'?22:18);g.appendChild(c);const t=document.createElementNS(NS,'text');t.setAttribute('x',p.x);t.setAttribute('y',p.y+3);t.setAttribute('text-anchor','middle');let label=n.label.length>18?n.label.slice(0,16)+'…':n.label;t.textContent=label;g.appendChild(t);const title=document.createElementNS(NS,'title');title.textContent=n.label;g.appendChild(title);svg.appendChild(g)})})();
</script></body></html>
